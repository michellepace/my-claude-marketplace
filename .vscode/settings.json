{
    // General editor settings
    "window.commandCenter": true,   // search box at top of window
    "editor.colorDecorators": true, // show colour pickers in code

    // Hide generated cache dirs from the Explorer
    "files.exclude": {
        "**/__pycache__": true,
        "**/.pytest_cache": true,
        "**/.ruff_cache": true,
        "**/.venv": true
    },

    // 🐍 UV PYTHON ENVIRONMENT
    // .venv/ exists only so pyright (Claude Code LSP plugin) has an interpreter —
    // see venvPath/venv in pyproject.toml. It holds no packages.
    // uv convention: never activate it — run commands via `uvx` / `uv run <cmd>`.
    // Without this, ms-python.python sources .venv/bin/activate in every terminal.
    "python.terminal.activateEnvironment": false,

    // 🐍 Ruff: Python lint & format (see pyproject.toml)
    "ruff.nativeServer": "on",  // faster Rust-based language server
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            "source.fixAll.ruff": "explicit", // autofix on save
            "source.organizeImports.ruff": "explicit" // organise on save
        }
    },

    // 🧩 Even Better TOML (tamasfe.even-better-toml)
    "[toml]": {
        "editor.defaultFormatter": "tamasfe.even-better-toml",
        "editor.formatOnSave": true
    },

    // 📝 Markdownlint (davidanson.vscode-markdownlint)
    "[markdown]": {
        "editor.codeActionsOnSave": {
            "source.fixAll.markdownlint": "explicit"
        }
    },
}
